# ==============================================================================
# AI Reviewer - Environment Configuration
# ==============================================================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Database (MongoDB Atlas) - REQUIRED for production & Vercel
# ------------------------------------------------------------------------------
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-reviewer?retryWrites=true&w=majority
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Authentication & Security - REQUIRED for production
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random string (e.g. openssl rand -base64 32)
JWT_SECRET=
# Passcode required to enter and unlock /admin dashboard settings
ADMIN_PASSCODE=admin123

# ------------------------------------------------------------------------------
# 3. Object Storage - Vercel Blob (Recommended for Vercel)
# ------------------------------------------------------------------------------
# Automatically created & linked when adding "Storage -> Blob" in Vercel project dashboard.
BLOB_READ_WRITE_TOKEN=

# Alternative Object Storage: Cloudflare R2 (Used if BLOB_READ_WRITE_TOKEN is not set)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=ai-reviewer-documents
CLOUDFLARE_R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 4. AI Provider Configuration
# ------------------------------------------------------------------------------
# AI_PROVIDER options: "gemini" or "heuristics"
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional alternate providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COPYLEAKS_API_KEY=

# ------------------------------------------------------------------------------
# 5. Background Jobs (Inngest) - Recommended for Serverless Vercel
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 6. Google OAuth 2.0 - For Real "Continue with Google" Authentication
# ------------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Redirect URI: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
